# ---- LLM ----
# The agent runs on Groq. Currently only "groq" is supported.
LLM_PROVIDER=groq

# Groq (free tier) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- MongoDB ----
MONGODB_URI=mongodb://root:example@localhost:27017/
MONGODB_DB=procurement
MONGODB_COLLECTION=purchase_orders

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins (Angular dev server)
CORS_ORIGINS=http://localhost:4200
